---
import "../styles/global.css";
import Header from "../islands/Header";
import Footer from "../components/Footer.astro";
import MobileBar from "../components/MobileBar.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { site, nav } from "../data/site";

interface Props { title?: string; description?: string; image?: string }
const { title = site.title, description = site.description, image = "/video/hero-poster.jpg" } = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://www.oceansidederm.com").toString();

const schema = {
  "@context": "https://schema.org",
  "@type": "Dermatology",
  name: site.name,
  url: "https://www.oceansidederm.com/",
  telephone: site.phone,
  email: site.email,
  image: "https://www.oceansidederm.com/images/dr-sophia-sandhu.webp",
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.zip,
    addressCountry: "US",
  },
  openingHours: "Mo-Fr 08:30-17:00",
  medicalSpecialty: "Dermatology",
  availableLanguage: site.languages,
};
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Display&family=Jost:wght@300;400;500&display=swap"
    />
    <link rel="preload" as="image" href="/video/hero-poster.jpg" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-white focus:px-4 focus:py-2">Skip to content</a>
    <Header client:load nav={nav} phone={site.phone} phoneHref={site.phoneHref} appointmentHref={site.appointmentHref} />
    <main id="main"><slot /></main>
    <Footer />
    <MobileBar />
    <CookieBanner />

    <script>
      // Reveal elements marked with data-reveal as they scroll into view.
      const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.12 }
      );
      els.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
