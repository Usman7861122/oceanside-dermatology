---
// Dr. Sophia Sandhu: bio, at-a-glance band, training path, distinctions, focus areas, languages, reviews.
import PageLayout from "../layouts/PageLayout.astro";
import AppointmentButton from "../components/AppointmentButton.astro";
import TestimonialsSection from "../components/home/TestimonialsSection.astro";
import { doctor, stats, credentials, drHero, focusAreas, languages } from "../data/about";
import { localFor } from "../data/local";
import { site } from "../data/site";

const local = localFor("About", "about");
// Lucide-style line icons for the training path (cap, stethoscope, hospital, award).
const icons = [
  '<path d="M21.42 10.92a1 1 0 0 0-.02-1.84L12.83 5.2a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.83l8.57 3.91a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>',
  '<path d="M11 2v2"/><path d="M5 2v2"/><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/>',
  '<path d="M12 6v4"/><path d="M14 14h-4"/><path d="M14 18h-4"/><path d="M14 8h-4"/><path d="M18 12h2a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2h2"/><path d="M18 22V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v18"/>',
  '<path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/><circle cx="12" cy="8" r="6"/>',
];
const personLd = {
  "@context": "https://schema.org",
  "@type": "Physician",
  name: "Sophia Sandhu, MD, FAAD",
  medicalSpecialty: "Dermatology",
  image: "https://www.oceansidederm.com/images/about/dr-sandhu-portrait.webp",
  telephone: site.phone,
  knowsLanguage: ["English", "Spanish", "Punjabi"],
  alumniOf: ["University of California, Los Angeles", "Eastern Virginia Medical School", "Harbor-UCLA Medical Center"],
  memberOf: ["American Academy of Dermatology", "American Society for Dermatologic Surgery", "Women's Dermatologic Society", "American Medical Association"],
  address: { "@type": "PostalAddress", streetAddress: "22330 Hawthorne Blvd Ste F", addressLocality: "Torrance", addressRegion: "CA", postalCode: "90505" },
};
---
<PageLayout
  title={drHero.title}
  accent={drHero.accent}
  metaTitle="Dr. Sophia Sandhu, MD, FAAD | Board-Certified Dermatologist in Torrance, CA"
  eyebrow="Dr. Sandhu"
  lede={drHero.lede}
  description={drHero.description}
  image={drHero.image}
  imageAlt={drHero.imageAlt}
  position="right bottom"
  local={local.banner}
  portrait={{ src: doctor.image, alt: doctor.imageAlt }}
>
  <script type="application/ld+json" set:html={JSON.stringify(personLd)} />

  <!-- The doctor -->
  <section id="bio" class="scroll-mt-24 bg-white py-24 sm:py-32">
    <div class="mx-auto grid max-w-7xl gap-14 px-5 sm:px-8 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <aside class="glance relative overflow-hidden rounded-[var(--radius-photo)] border border-line bg-marble/60 p-8 lg:sticky lg:top-32" data-reveal>
          <span class="absolute left-0 top-0 h-px w-16 bg-gold" aria-hidden="true"></span>
          <p class="m-0 font-display text-[1.7rem] leading-tight text-ink">{doctor.name}</p>
          <p class="m-0 mt-2 text-[0.72rem] tracking-[0.2em] uppercase text-muted">{doctor.role}</p>
          <dl class="-mx-4 m-0 mt-8 divide-y divide-line border-y border-line">
            {[
              ["Board certification", "Fellow, American Academy of Dermatology"],
              ["Residency", "Harbor-UCLA Medical Center, Chief Resident"],
              ["Advanced training", "UCSF (WDS Mentorship Award)"],
              ["Medical school", "Eastern Virginia Medical School"],
              ["Languages", doctor.languages.join(", ")],
            ].map(([k, v]) => (
              <div class="glance-row group relative px-4 py-4">
                <span class="absolute inset-y-3 left-0 w-px origin-top scale-y-0 bg-gold transition-transform duration-500 [transition-timing-function:var(--ease-tide)] group-hover:scale-y-100" aria-hidden="true"></span>
                <dt class="text-[0.65rem] font-medium tracking-[0.2em] uppercase text-gold transition-[letter-spacing] duration-500 group-hover:tracking-[0.26em]">{k}</dt>
                <dd class="m-0 mt-1 text-[0.95rem] text-ink transition-all duration-500 [transition-timing-function:var(--ease-tide)] group-hover:translate-x-1.5 group-hover:text-gold">{v}</dd>
              </div>
            ))}
          </dl>
          <div class="mt-8 flex flex-col gap-3">
            <AppointmentButton />
            <a href={site.phoneHref} class="btn-line justify-center">Call {site.phone}</a>
          </div>
        </aside>
      </div>

      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal><span class="rule-gold"></span>Meet Your Dermatologist</p>
        <h2 class="mt-6 text-4xl leading-[1.12] [text-wrap:balance] sm:text-5xl" data-reveal style="--reveal-delay:100ms">
          Medical, cosmetic and surgical dermatology, <em class="text-gold">close to home</em>
        </h2>
        <div class="mt-10 space-y-6 text-[1.05rem] leading-relaxed text-body">
          {doctor.bio.map((p, i) => <p data-reveal style={`--reveal-delay:${80 * i}ms`}>{p}</p>)}
        </div>

        <blockquote class="relative mt-12 border-l border-gold py-2 pl-8" data-reveal>
          <p class="font-display text-2xl leading-snug text-ink sm:text-[1.75rem]">“{doctor.quote}”</p>
          <footer class="mt-4 text-[0.72rem] tracking-[0.2em] uppercase text-muted">Our promise to every patient</footer>
        </blockquote>

      </div>
    </div>
  </section>

  <!-- Stats band -->
  <section class="parallax-window relative isolate bg-ink py-28 text-white sm:py-36" style="background-image:url('/images/about/treatment-room.webp')" aria-label="Dr. Sandhu at a glance">
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgb(15_34_41/0.55),rgb(15_34_41/0.72))]"></div>
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <p class="eyebrow justify-center !text-gold-soft" data-reveal><span class="rule-gold"></span>Trained at Harbor-UCLA &amp; UCSF<span class="rule-gold"></span></p>
      <ul class="m-0 mt-14 grid list-none gap-px overflow-hidden rounded-[var(--radius-photo)] border border-white/12 bg-white/12 p-0 sm:grid-cols-3">
        {stats.map((s, i) => (
          <li class="stat bg-[rgb(10_22_27/0.55)] px-8 py-12 text-center backdrop-blur-md" data-reveal style={`--reveal-delay:${120 * i}ms`}>
            <span class="block font-display text-[2.4rem] leading-none text-white sm:text-[2.6rem]">{s.value}</span>
            <span class="mx-auto mt-5 block h-px w-8 bg-gold" aria-hidden="true"></span>
            <span class="mx-auto mt-5 block max-w-[16rem] text-[0.92rem] text-white/70">{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Credentials -->
  <section id="credentials" class="marble-light relative overflow-hidden py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow" data-reveal><span class="rule-gold"></span>Education &amp; Credentials</p>
          <h2 class="mt-6 text-4xl [text-wrap:balance] sm:text-5xl" data-reveal style="--reveal-delay:100ms">From UCLA to <em class="text-gold">Chief Resident</em></h2>
        </div>
        <p class="text-body lg:col-span-5" data-reveal style="--reveal-delay:200ms">{credentials.research}</p>
      </div>

      <!-- Training path: four icon cards joined by a gold line -->
      <ol class="path relative m-0 mt-24 grid list-none gap-14 p-0 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
        <span class="absolute left-[12.5%] right-[12.5%] top-9 hidden h-px bg-gradient-to-r from-gold/20 via-gold/70 to-gold/20 lg:block" aria-hidden="true"></span>
        {credentials.education.map((e, i) => (
          <li class="edu-card group relative flex flex-col items-center rounded-[var(--radius-photo)] border border-line bg-white px-7 pb-9 pt-0 text-center" data-reveal style={`--reveal-delay:${110 * i}ms`}>
            <span class="relative z-10 -mt-9 grid h-[72px] w-[72px] place-items-center rounded-full border border-gold/60 bg-white text-gold shadow-[0_14px_30px_-18px_rgb(15_34_41/0.45)] transition-colors duration-500 group-hover:bg-gold group-hover:text-white" aria-hidden="true">
              <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} />
            </span>
            <span class="mt-6 block font-display text-[0.95rem] text-gold/70">0{i + 1}</span>
            <span class="mt-2 block text-[0.7rem] font-medium tracking-[0.22em] uppercase text-gold">{e.step}</span>
            <span class="mt-3 block font-display text-[1.55rem] leading-tight text-ink">{e.place}</span>
            <span class="mx-auto mt-4 block h-px w-8 bg-gold/60 transition-all duration-500 group-hover:w-14" aria-hidden="true"></span>
            <span class="mt-4 block text-[0.95rem] text-body">{e.detail}</span>
            {e.note && <span class="mt-3 inline-block rounded-[3px] border border-gold/40 bg-gold/[0.06] px-3 py-1.5 text-[0.75rem] tracking-[0.04em] text-ink">{e.note}</span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Awards and memberships on deep marble -->
  <section id="honors" class="marble-deep relative isolate overflow-hidden py-24 text-white sm:py-32">
    <div aria-hidden="true" class="pointer-events-none absolute -right-40 top-0 -z-10 h-[30rem] w-[30rem] rounded-full bg-gold/10 blur-3xl"></div>
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="flex justify-center"><p class="eyebrow justify-center !text-gold-soft" data-reveal><span class="rule-gold"></span>Distinctions<span class="rule-gold"></span></p></div>
      <h2 class="mx-auto mt-6 max-w-3xl text-center text-4xl !text-white [text-wrap:balance] sm:text-5xl" data-reveal style="--reveal-delay:100ms">
        Prestigious awards for <em class="text-gold">advanced training</em>
      </h2>

      <div class="mt-16 grid gap-6 md:grid-cols-2">
        {credentials.awards.map((a, i) => (
          <article class="award group relative overflow-hidden rounded-[var(--radius-photo)] border border-white/12 bg-white/[0.04] p-10 backdrop-blur-sm sm:p-12" data-reveal style={`--reveal-delay:${140 * i}ms`}>
            <span class="absolute left-0 top-0 h-px w-0 bg-gold transition-all duration-700 [transition-timing-function:var(--ease-tide)] group-hover:w-full" aria-hidden="true"></span>
            <svg class="h-12 w-12 text-gold" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
              <circle cx="24" cy="19" r="11" /><circle cx="24" cy="19" r="7" stroke-opacity=".5" />
              <path d="M17 28l-4 14 6-3 4 5 1-12M31 28l4 14-6-3-4 5-1-12" stroke-linejoin="round" />
            </svg>
            <p class="m-0 mt-8 text-[0.72rem] font-medium tracking-[0.22em] uppercase text-white/55">{a.org}</p>
            <h3 class="mt-3 font-display text-[2.1rem] leading-tight !text-white transition-colors duration-500 group-hover:!text-gold sm:text-[2.4rem]">{a.title}</h3>
            <p class="mt-5 max-w-md text-white/70">{a.detail}</p>
          </article>
        ))}
      </div>

      <div class="mt-20" data-reveal>
        <p class="m-0 text-center text-[0.72rem] font-medium tracking-[0.22em] uppercase text-white/55">Professional memberships</p>
        <ul class="m-0 mt-8 grid list-none grid-cols-2 border-y border-white/12 p-0 lg:grid-cols-4">
          {credentials.memberships.map((m, i) => (
            <li class={`member group flex flex-col items-center px-4 py-10 text-center ${i % 2 ? "border-l border-white/12" : ""} ${i === 2 ? "lg:border-l" : ""} ${i > 1 ? "border-t border-white/12 lg:border-t-0" : ""}`}>
              <span class="block font-display text-[2.6rem] leading-none text-white transition-colors duration-500 group-hover:text-gold">{m.mark}</span>
              <span class="mx-auto mt-4 block h-px w-6 bg-gold/70 transition-all duration-500 group-hover:w-12" aria-hidden="true"></span>
              <span class="mx-auto mt-4 block max-w-[14rem] flex-1 text-[0.88rem] text-white/70">{m.name}</span>
              <span class="mt-3 block text-[0.72rem] tracking-[0.18em] uppercase text-gold-soft">{m.note}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Focus areas -->
  <section class="marble-light py-24 sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow" data-reveal><span class="rule-gold"></span>Areas of Expertise</p>
          <h2 class="mt-6 text-4xl [text-wrap:balance] sm:text-5xl" data-reveal style="--reveal-delay:100ms">Complete care, <em class="text-gold">one dermatologist</em></h2>
        </div>
        <p class="text-body lg:col-span-5" data-reveal style="--reveal-delay:160ms">Dr. Sandhu has comprehensive expertise in medical, cosmetic and surgical dermatology, and cares for patients from newborns to adults.</p>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-[var(--radius-photo)] border border-ink/10 bg-ink/10 sm:grid-cols-2 lg:grid-cols-4">
        {focusAreas.map((f, i) => (
          <a href={f.href} class="focus group relative flex flex-col bg-white/85 px-7 py-9 backdrop-blur-sm" data-reveal style={`--reveal-delay:${90 * i}ms`}>
            <span class="absolute left-0 top-0 h-px w-0 bg-gold transition-all duration-700 [transition-timing-function:var(--ease-tide)] group-hover:w-full" aria-hidden="true"></span>
            <span class="font-display text-[1.5rem] leading-tight text-ink transition-colors duration-500 group-hover:text-gold">{f.title}</span>
            <span class="mt-3 flex-1 text-[0.95rem] text-body">{f.text}</span>
            <span class="mt-6 inline-flex items-center gap-2 text-[0.7rem] font-medium tracking-[0.2em] uppercase text-ink">Explore <span class="text-gold transition-transform duration-500 group-hover:translate-x-1" aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Languages -->
  <section class="bg-white py-20 sm:py-24">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-5 sm:px-8 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal><span class="rule-gold"></span>Care in Your Language</p>
        <h2 class="mt-6 text-4xl [text-wrap:balance] sm:text-5xl" data-reveal style="--reveal-delay:100ms">Speak with Dr. Sandhu <em class="text-gold">your way</em></h2>
      </div>
      <ul class="m-0 grid list-none grid-cols-3 border-y border-line p-0 lg:col-span-7">
        {languages.map((l, i) => (
          <li class={`lang group px-4 py-10 text-center ${i ? "border-l border-line" : ""}`} data-reveal style={`--reveal-delay:${100 * i}ms`}>
            <span class="block font-display text-[2.2rem] leading-none text-ink transition-colors duration-500 group-hover:text-gold sm:text-[2.6rem]">{l.native}</span>
            <span class="mx-auto mt-4 block h-px w-6 bg-gold/70 transition-all duration-500 group-hover:w-12" aria-hidden="true"></span>
            <span class="mt-4 block text-[0.72rem] tracking-[0.2em] uppercase text-muted">{l.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <TestimonialsSection />
</PageLayout>

<style>
  .stat { transition: background-color 0.7s var(--ease-tide); }
  .stat:hover { background-color: rgb(255 255 255 / 0.08); }
  .award { transition: transform 0.7s var(--ease-tide), border-color 0.7s var(--ease-tide), background-color 0.7s var(--ease-tide), box-shadow 0.7s var(--ease-tide); }
  .award:hover { transform: translateY(-6px); border-color: rgb(236 143 46 / 0.5); background-color: rgb(255 255 255 / 0.07); box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.7); }
  .approach { transition: background-color 0.6s var(--ease-tide); }
  .approach:hover { background-color: #fff; }
  @media (prefers-reduced-motion: reduce) { .award:hover { transform: none; } }
  .edu-card { transition: transform 0.7s var(--ease-tide), box-shadow 0.7s var(--ease-tide), border-color 0.7s var(--ease-tide); }
  .edu-card:hover { transform: translateY(-6px); border-color: rgb(236 143 46 / 0.45); box-shadow: 0 34px 60px -36px rgb(15 34 41 / 0.35); }
  @media (prefers-reduced-motion: reduce) { .edu-card:hover { transform: none; } }
  .glance-row { transition: background-color 0.5s var(--ease-tide); }
  .glance-row:hover { background-color: rgb(255 255 255 / 0.9); }
  .glance { transition: box-shadow 0.7s var(--ease-tide), border-color 0.7s var(--ease-tide); }
  .glance:hover { border-color: rgb(236 143 46 / 0.45); box-shadow: 0 30px 60px -35px rgb(15 34 41 / 0.3); }
  .focus { transition: background-color 0.6s var(--ease-tide); }
  .focus:hover { background-color: #fff; }
</style>

