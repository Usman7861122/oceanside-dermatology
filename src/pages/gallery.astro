---
// Gallery page: topic filter, square photo grid with a few large tiles, and a lightbox
// (arrow keys, Escape, swipe). Photos come from src/data/gallery.ts.
import PageLayout from "../layouts/PageLayout.astro";
import { galleryPhotos, galleryTopics } from "../data/gallery";
import { localFor } from "../data/local";
import { site } from "../data/site";

const local = localFor("Gallery", "about");
const counts = Object.fromEntries(galleryTopics.map((t) => [t.key, galleryPhotos.filter((p) => p.topic === t.key).length]));
---
<PageLayout
  title="Gallery"
  accent="The Oceanside Experience"
  metaTitle={`Gallery | ${site.name}, Torrance, CA`}
  eyebrow="Gallery"
  lede="A look inside our Torrance practice and the calm, careful approach we bring to every visit."
  description="Photos of Oceanside Dermatology & Aesthetics in Torrance, CA: our practice, consultations with Dr. Sophia Sandhu, and healthy skin care."
  image="/images/services/index/services-hero.webp"
  imageAlt="Bright, modern clinic interior at Oceanside Dermatology & Aesthetics"
  local={local.banner}
>
  <section class="bg-white py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="eyebrow" data-reveal><span class="rule-gold"></span>Browse</p>
          <h2 class="mt-6 text-4xl [text-wrap:balance] sm:text-5xl" data-reveal style="--reveal-delay:100ms">Inside <em class="text-gold">Oceanside</em></h2>
        </div>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter photos" data-reveal>
          <button type="button" class="gal-filter is-active" data-filter="all" aria-pressed="true">All <span>{galleryPhotos.length}</span></button>
          {galleryTopics.map((t) => (
            <button type="button" class="gal-filter" data-filter={t.key} aria-pressed="false">{t.label} <span>{counts[t.key]}</span></button>
          ))}
        </div>
      </div>

      <ul id="gal-grid" class="mt-12 grid list-none grid-cols-2 gap-3 p-0 [grid-auto-flow:dense] sm:gap-4 lg:grid-cols-4">
        {galleryPhotos.map((p, i) => (
          <li class={`gal-item ${p.big ? "col-span-2 row-span-2" : ""}`} data-topic={p.topic}>
            <button type="button" class="gal-tile group relative block aspect-square w-full overflow-hidden rounded-[var(--radius-photo)] bg-mist" data-index={i} aria-label={`Open photo: ${p.title}`}>
              <img src={p.src} alt={p.alt} width="1400" height="1400" loading={i < 6 ? "eager" : "lazy"} class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1.4s] [transition-timing-function:var(--ease-tide)] group-hover:scale-[1.05]" />
              <span class="absolute inset-0 bg-gradient-to-t from-ink/75 via-ink/0 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100 group-focus-visible:opacity-100" aria-hidden="true"></span>
              <span class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 p-4 text-left opacity-0 transition-all duration-500 [transform:translateY(8px)] group-hover:opacity-100 group-hover:[transform:none] group-focus-visible:opacity-100 group-focus-visible:[transform:none] sm:p-5">
                <span class="font-display text-[1.05rem] leading-snug text-white sm:text-[1.25rem]">{p.title}</span>
                <svg class="h-5 w-5 shrink-0 text-gold-soft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
              </span>
            </button>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-[0.85rem] text-muted">Photos of people are models, not patients.</p>
    </div>
  </section>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 z-[60] hidden items-center justify-center bg-ink/95 p-4 backdrop-blur-sm sm:p-10" role="dialog" aria-modal="true" aria-label="Photo viewer">
    <figure class="relative m-0 flex max-h-full w-full max-w-5xl flex-col items-center">
      <img id="lb-img" alt="" class="max-h-[78svh] w-auto max-w-full rounded-[var(--radius-photo)] object-contain shadow-[0_40px_90px_-30px_rgb(0_0_0/0.8)]" />
      <figcaption class="mt-5 flex w-full items-center justify-between gap-4 text-white">
        <span id="lb-title" class="font-display text-[1.3rem]"></span>
        <span id="lb-count" class="text-[0.75rem] tracking-[0.2em] text-white/60"></span>
      </figcaption>
    </figure>
    <button type="button" id="lb-close" class="lb-btn absolute right-4 top-4 sm:right-6 sm:top-6" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
    <button type="button" id="lb-prev" class="lb-btn absolute left-3 top-1/2 -translate-y-1/2 sm:left-6" aria-label="Previous photo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
    </button>
    <button type="button" id="lb-next" class="lb-btn absolute right-3 top-1/2 -translate-y-1/2 sm:right-6" aria-label="Next photo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </button>
  </div>
</PageLayout>

<style>
  .gal-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid rgb(15 34 41 / 0.15);
    border-radius: 3px;
    padding: 0.6rem 1rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--color-ink);
    transition: border-color 0.3s, background-color 0.3s, color 0.3s;
  }
  .gal-filter span { font-size: 0.68rem; color: var(--color-muted); transition: color 0.3s; }
  .gal-filter:hover { border-color: var(--color-gold); }
  .gal-filter.is-active { background: var(--color-ink); border-color: var(--color-ink); color: #fff; }
  .gal-filter.is-active span { color: var(--color-gold-soft); }
  .gal-tile:focus-visible, .gal-filter:focus-visible, .lb-btn:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 3px; }
  .gal-item { animation: gal-in 0.6s var(--ease-tide) both; }
  @keyframes gal-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .lb-btn {
    display: flex;
    height: 3rem;
    width: 3rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 3px;
    color: #fff;
    background: rgb(15 34 41 / 0.4);
    transition: border-color 0.3s, color 0.3s;
  }
  .lb-btn:hover { border-color: var(--color-gold); color: var(--color-gold-soft); }
  .lb-btn svg { height: 1.3rem; width: 1.3rem; }
  @media (prefers-reduced-motion: reduce) { .gal-item { animation: none; } }
</style>

<script>
  import { galleryPhotos } from "../data/gallery";

  const items = [...document.querySelectorAll<HTMLLIElement>(".gal-item")];
  const filters = [...document.querySelectorAll<HTMLButtonElement>(".gal-filter")];
  let visible = items.map((_, i) => i);

  filters.forEach((btn) =>
    btn.addEventListener("click", () => {
      const f = btn.dataset.filter;
      filters.forEach((b) => { b.classList.toggle("is-active", b === btn); b.setAttribute("aria-pressed", String(b === btn)); });
      visible = [];
      items.forEach((li, i) => {
        const show = f === "all" || li.dataset.topic === f;
        li.hidden = !show;
        // Large tiles only in the full view, so filtered grids stay tidy.
        li.classList.toggle("col-span-2", show && f === "all" && !!galleryPhotos[i].big);
        li.classList.toggle("row-span-2", show && f === "all" && !!galleryPhotos[i].big);
        if (show) { visible.push(i); li.style.animation = "none"; void li.offsetWidth; li.style.animation = ""; }
      });
    })
  );

  const lb = document.getElementById("lightbox")!;
  const img = document.getElementById("lb-img") as HTMLImageElement;
  const title = document.getElementById("lb-title")!;
  const count = document.getElementById("lb-count")!;
  let pos = 0;
  let opener: HTMLElement | null = null;

  const show = (p: number) => {
    pos = (p + visible.length) % visible.length;
    const ph = galleryPhotos[visible[pos]];
    img.src = ph.src; img.alt = ph.alt; title.textContent = ph.title;
    count.textContent = `${pos + 1} / ${visible.length}`;
  };
  const open = (index: number, from: HTMLElement) => {
    opener = from;
    show(visible.indexOf(index));
    lb.classList.remove("hidden"); lb.classList.add("flex");
    document.body.style.overflow = "hidden";
    document.getElementById("lb-close")?.focus();
  };
  const close = () => {
    lb.classList.add("hidden"); lb.classList.remove("flex");
    document.body.style.overflow = "";
    opener?.focus();
  };

  document.querySelectorAll<HTMLButtonElement>(".gal-tile").forEach((t) => t.addEventListener("click", () => open(Number(t.dataset.index), t)));
  document.getElementById("lb-close")?.addEventListener("click", close);
  document.getElementById("lb-prev")?.addEventListener("click", () => show(pos - 1));
  document.getElementById("lb-next")?.addEventListener("click", () => show(pos + 1));
  lb.addEventListener("click", (e) => { if (e.target === lb) close(); });
  document.addEventListener("keydown", (e) => {
    if (lb.classList.contains("hidden")) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowLeft") show(pos - 1);
    if (e.key === "ArrowRight") show(pos + 1);
    if (e.key === "Tab") {
      const f = [...lb.querySelectorAll<HTMLElement>("button")];
      const i = f.indexOf(document.activeElement as HTMLElement);
      e.preventDefault();
      f[(i + (e.shiftKey ? -1 : 1) + f.length) % f.length].focus();
    }
  });
  let x0 = 0;
  lb.addEventListener("touchstart", (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  lb.addEventListener("touchend", (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) show(pos + (dx < 0 ? 1 : -1));
  });
</script>
