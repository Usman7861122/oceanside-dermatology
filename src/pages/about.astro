---
// About page: hero, the practice, Dr. Sandhu, our approach, local section, reviews.
import PageLayout from "../layouts/PageLayout.astro";
import AppointmentButton from "../components/AppointmentButton.astro";
import LocalSection from "../components/page/LocalSection.astro";
import TestimonialsSection from "../components/home/TestimonialsSection.astro";
import { aboutHero, doctor, approach, practiceWelcome } from "../data/about";
import { localFor } from "../data/local";
import { site } from "../data/site";

const local = localFor("About", "about");
---
<PageLayout
  title={aboutHero.title}
  accent={aboutHero.accent}
  metaTitle="About Oceanside Dermatology & Aesthetics | Dermatologist in Torrance, CA"
  eyebrow="About"
  lede={aboutHero.lede}
  description={aboutHero.description}
  image={aboutHero.image}
  imageAlt={aboutHero.imageAlt}
  position="center 60%"
  local={local.banner}
>
  <!-- Welcome to the practice -->
  <section id="practice" class="bg-white py-24 sm:py-32">
    <div class="mx-auto grid max-w-7xl items-center gap-14 px-5 sm:px-8 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal><span class="rule-gold"></span>Our Practice</p>
        <h2 class="mt-6 text-4xl leading-[1.12] [text-wrap:balance] sm:text-5xl" data-reveal style="--reveal-delay:100ms">Trusted care for <em class="text-gold">healthy skin</em></h2>
        <div class="mt-10 space-y-6 text-[1.05rem] leading-relaxed text-body">
          {practiceWelcome.map((p, i) => <p data-reveal style={`--reveal-delay:${80 * i}ms`}>{p}</p>)}
        </div>
        <div class="mt-12 flex flex-wrap gap-4" data-reveal>
          <AppointmentButton />
          <a href="/services" class="btn-line">Our Services <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <figure class="group relative lg:col-span-5" data-reveal>
        <div class="absolute -bottom-4 -right-4 h-full w-full rounded-[var(--radius-photo)] border border-gold/60" aria-hidden="true"></div>
        <div class="relative overflow-hidden rounded-[var(--radius-photo)]">
          <img src="/images/practice/reception.webp" alt="Reception desk at Oceanside Dermatology & Aesthetics with an olive tree" width="1400" height="1400" loading="lazy" class="photo-square w-full object-cover transition-transform duration-[1.6s] [transition-timing-function:var(--ease-tide)] group-hover:scale-[1.04]" />
        </div>
      </figure>
    </div>
  </section>

  <!-- Meet Dr. Sandhu -->
  <section id="dr-sandhu" class="marble-deep relative isolate scroll-mt-24 overflow-hidden py-24 text-white sm:py-32">
    <div class="mx-auto grid max-w-7xl items-center gap-14 px-5 sm:px-8 lg:grid-cols-12 lg:gap-20">
      <figure class="group relative mx-auto w-full max-w-md lg:col-span-5 lg:max-w-none" data-reveal>
        <div class="absolute -bottom-4 -left-4 h-full w-full rounded-[var(--radius-photo)] border border-gold/60" aria-hidden="true"></div>
        <div class="relative overflow-hidden rounded-[var(--radius-photo)] bg-mist">
          <img src={doctor.image} alt={doctor.imageAlt} width="1024" height="1024" loading="lazy" class="photo-square w-full object-cover object-[50%_15%] transition-transform duration-[1.6s] [transition-timing-function:var(--ease-tide)] group-hover:scale-[1.04]" />
        </div>
      </figure>
      <div class="lg:col-span-7">
        <p class="eyebrow !text-gold-soft" data-reveal><span class="rule-gold"></span>Meet Your Dermatologist</p>
        <h2 class="mt-6 text-4xl !text-white [text-wrap:balance] sm:text-5xl" data-reveal style="--reveal-delay:100ms">{doctor.name}</h2>
        <p class="m-0 mt-3 text-[0.75rem] tracking-[0.22em] uppercase text-gold-soft" data-reveal>{doctor.role}</p>
        <p class="mt-8 max-w-2xl text-[1.05rem] leading-relaxed text-white/80" data-reveal>{doctor.bio[0]}</p>
        <blockquote class="mt-8 border-l border-gold py-1 pl-6" data-reveal>
          <p class="font-display text-[1.5rem] leading-snug text-white">“{doctor.quote}”</p>
        </blockquote>
        <div class="mt-10 flex flex-wrap gap-4" data-reveal>
          <a href="/dr-sophia-sandhu" class="btn-line text-white">Meet Dr. Sandhu <span class="arrow" aria-hidden="true">→</span></a>
          <AppointmentButton glass />
        </div>
      </div>
    </div>
  </section>

  <!-- Our approach -->
  <section id="approach" class="marble-light py-24 sm:py-32">
    <div class="mx-auto grid max-w-7xl items-center gap-14 px-5 sm:px-8 lg:grid-cols-12 lg:gap-20">
      <figure class="group relative overflow-hidden rounded-[var(--radius-photo)] lg:col-span-6" data-reveal>
        <img src={approach.image} alt={approach.imageAlt} width="1400" height="1400" loading="lazy"
          class="photo-square w-full object-cover transition-transform duration-[1.6s] [transition-timing-function:var(--ease-tide)] group-hover:scale-[1.04]" />
      </figure>
      <div class="lg:col-span-6">
        <p class="eyebrow" data-reveal><span class="rule-gold"></span>Our Philosophy</p>
        <h2 class="mt-6 text-4xl [text-wrap:balance] sm:text-5xl" data-reveal style="--reveal-delay:100ms">{approach.title}</h2>
        <p class="mt-6 text-[1.05rem] text-body" data-reveal style="--reveal-delay:160ms">{approach.intro}</p>
        <div class="mt-10 grid gap-px overflow-hidden rounded-[var(--radius-photo)] border border-ink/10 bg-ink/10 sm:grid-cols-2">
          {approach.points.map((p, i) => (
            <div class="approach group relative bg-white/80 px-6 py-7 backdrop-blur-sm" data-reveal style={`--reveal-delay:${90 * i}ms`}>
              <span class="absolute left-0 top-0 h-px w-0 bg-gold transition-all duration-700 [transition-timing-function:var(--ease-tide)] group-hover:w-full" aria-hidden="true"></span>
              <h3 class="text-xl transition-colors duration-500 group-hover:text-gold">{p.title}</h3>
              <p class="mt-2 text-[0.93rem] text-body">{p.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <LocalSection local={local} />
  <TestimonialsSection />
</PageLayout>

<style>
  .stat { transition: background-color 0.7s var(--ease-tide); }
  .stat:hover { background-color: rgb(255 255 255 / 0.08); }
  .award { transition: transform 0.7s var(--ease-tide), border-color 0.7s var(--ease-tide), background-color 0.7s var(--ease-tide), box-shadow 0.7s var(--ease-tide); }
  .award:hover { transform: translateY(-6px); border-color: rgb(236 143 46 / 0.5); background-color: rgb(255 255 255 / 0.07); box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.7); }
  .approach { transition: background-color 0.6s var(--ease-tide); }
  .approach:hover { background-color: #fff; }
  @media (prefers-reduced-motion: reduce) { .award:hover { transform: none; } }
</style>
