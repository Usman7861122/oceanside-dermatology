---
// Contact page: four quick ways to reach us, the request form with office details,
// a privacy-friendly map (loads only when asked), and the local section.
import PageLayout from "../layouts/PageLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import LocalSection from "../components/page/LocalSection.astro";
import { localFor } from "../data/local";
import { site } from "../data/site";

const local = localFor("Dermatology", "about");
const fullAddress = `${site.address.street}, ${site.address.city}, ${site.address.region} ${site.address.zip}`;
const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent(fullAddress)}&output=embed`;

// Lucide-style icon paths (24px grid, stroke).
const ways = [
  { label: "Call", value: site.phone, note: `Fax ${site.fax}`, href: site.phoneHref, icon: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>' },
  { label: "Email", value: site.email, note: "Please keep medical details for your visit", href: `mailto:${site.email}`, icon: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>' },
  { label: "Visit", value: site.address.street.replace(/,?\s*Ste.*$/, ""), note: `${site.address.street.match(/Ste.*$/)?.[0] ?? ""}, ${site.address.city}, ${site.address.region} ${site.address.zip}`, href: site.mapsUrl, external: true, icon: '<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>' },
  { label: "Video visit", value: "Teledermatology", note: "See Dr. Sandhu from home", href: "/teledermatology", icon: '<path d="m16 13 5.2 3.5a.5.5 0 0 0 .8-.4V7.9a.5.5 0 0 0-.8-.4L16 11"/><rect x="2" y="6" width="14" height="12" rx="2"/>' },
];
const languageNames: Record<string, string> = { English: "English", Spanish: "Español", Punjabi: "ਪੰਜਾਬੀ" };
---
<PageLayout
  title="Contact Oceanside Dermatology"
  accent="in Torrance, CA"
  metaTitle="Contact Us | Oceanside Dermatology & Aesthetics, Torrance, CA"
  eyebrow="Contact"
  lede="Call, email or send a request and our team will help you find a time to see Dr. Sandhu."
  description={`Contact Oceanside Dermatology & Aesthetics at ${fullAddress}. Call ${site.phone}, email ${site.email}, or request an appointment online.`}
  image="/images/south-bay-pier.webp"
  imageAlt="South Bay pier at sunset, near Oceanside Dermatology & Aesthetics in Torrance"
  position="center 60%"
  local={local.banner}
  nearby={local.nearby}
>
  <!-- Four quick ways to reach us -->
  <section class="bg-white py-20 sm:py-24" aria-label="Ways to reach us">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-px overflow-hidden rounded-[var(--radius-photo)] border border-ink/10 bg-ink/10 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
      {ways.map((w) => (
        <a href={w.href} {...(w.external ? { target: "_blank", rel: "noopener" } : {})} class="way group relative flex flex-col bg-white px-7 py-9">
          <span class="absolute left-0 top-0 h-px w-0 bg-gold transition-all duration-700 [transition-timing-function:var(--ease-tide)] group-hover:w-full" aria-hidden="true"></span>
          <span class="flex h-12 w-12 items-center justify-center rounded-[var(--radius-photo)] border border-gold/40 text-gold transition-colors duration-500 group-hover:bg-gold group-hover:text-white">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={w.icon} />
          </span>
          <span class="mt-7 text-[0.68rem] tracking-[0.22em] uppercase text-muted">{w.label}</span>
          <span class="mt-2 break-words font-display text-[1.35rem] leading-snug text-ink transition-colors duration-500 group-hover:text-gold">{w.value}</span>
          <span class="mt-2 text-[0.88rem] text-body">{w.note}</span>
          <span class="mt-auto pt-6 text-gold transition-transform duration-500 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
    </div>
  </section>

  <!-- Form and office details -->
  <section id="request" class="marble-light scroll-mt-24 py-24 sm:py-32">
    <div class="mx-auto grid max-w-7xl gap-14 px-5 sm:px-8 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-7 lg:order-2" data-reveal>
        <ContactForm />
      </div>
      <div class="lg:col-span-5 lg:order-1">
        <p class="eyebrow" data-reveal><span class="rule-gold"></span>Request a Visit</p>
        <h2 class="mt-6 text-4xl leading-[1.12] [text-wrap:balance] sm:text-5xl" data-reveal style="--reveal-delay:100ms">We look forward to <em class="text-gold">meeting you</em></h2>
        <p class="mt-6 max-w-md text-body" data-reveal style="--reveal-delay:160ms">Send a note and our team will reach out to schedule your visit. For anything urgent, please call the office.</p>

        <div class="mt-12 rounded-[var(--radius-photo)] border border-ink/10 bg-white/75 p-7 backdrop-blur-sm" data-reveal style="--reveal-delay:220ms">
          <h3 class="text-2xl">Office hours</h3>
          <dl class="mt-5 divide-y divide-ink/10">
            {site.hours.map((h) => (
              <div class="hours-row flex items-start justify-between gap-4 py-3" data-days={h.dayNums.join(",")}>
                <dt class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-ink">{h.days}<span class="today-tag hidden" data-today-tag>Today</span></dt>
                <dd class={`whitespace-nowrap ${h.time === "Closed" ? "text-muted" : "text-body"}`}>{h.time}</dd>
              </div>
            ))}
          </dl>
          <h3 class="mt-9 text-2xl">We speak</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {site.languages.map((l) => (
              <li class="rounded-[3px] border border-gold/40 px-3 py-1.5 text-[0.88rem] text-ink" lang={l === "Spanish" ? "es" : l === "Punjabi" ? "pa" : "en"}>{languageNames[l] ?? l}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Getting here: the map loads only when the visitor asks for it -->
  <section id="map" class="marble-deep relative isolate overflow-hidden py-24 text-white sm:py-32">
    <div class="mx-auto grid max-w-7xl items-center gap-14 px-5 sm:px-8 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <p class="eyebrow !text-gold-soft" data-reveal><span class="rule-gold"></span>Getting Here</p>
        <h2 class="mt-6 text-4xl !text-white [text-wrap:balance] sm:text-5xl" data-reveal style="--reveal-delay:100ms">On Hawthorne Blvd <em class="text-gold-soft">in Torrance</em></h2>
        <address class="mt-8 not-italic font-display text-[1.5rem] leading-snug text-white" data-reveal>
          {site.address.street}<br />{site.address.city}, {site.address.region} {site.address.zip}
        </address>
        <div class="mt-10 flex flex-wrap gap-4" data-reveal>
          <a href={site.mapsUrl} target="_blank" rel="noopener" class="btn-line text-white">Get directions <span class="arrow" aria-hidden="true">→</span></a>
          <a href={site.phoneHref} class="btn-line text-white">Call {site.phone}</a>
        </div>
      </div>
      <div class="lg:col-span-7" data-reveal style="--reveal-delay:160ms">
        <div id="map-frame" data-src={mapEmbed} class="relative aspect-[4/3] overflow-hidden rounded-[var(--radius-photo)] border border-white/15 bg-white/5 sm:aspect-[16/10]">
          <div id="map-cover" class="absolute inset-0 flex flex-col items-center justify-center gap-5 p-8 text-center">
            <svg class="h-10 w-10 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
            <p class="m-0 max-w-sm text-[0.95rem] text-white/75">The map is provided by Google, which may set its own cookies.</p>
            <button id="map-load" type="button" class="btn-line text-white">Show the map</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <LocalSection local={local} />
</PageLayout>

<style>
  .way { transition: background-color 0.6s var(--ease-tide); }
  .way:hover { background-color: #fdfaf6; }
</style>

<script>
  // Load the Google map only after a click (or if marketing cookies were already allowed).
  const frame = document.getElementById("map-frame");
  const load = () => {
    if (!frame || frame.querySelector("iframe")) return;
    const f = document.createElement("iframe");
    f.src = frame.dataset.src ?? "";
    f.title = "Map to Oceanside Dermatology & Aesthetics";
    f.loading = "lazy";
    f.referrerPolicy = "no-referrer-when-downgrade";
    f.className = "absolute inset-0 h-full w-full border-0";
    frame.appendChild(f);
    document.getElementById("map-cover")?.remove();
  };
  document.getElementById("map-load")?.addEventListener("click", load);
  try {
    if (JSON.parse(localStorage.getItem("osd-consent") ?? "null")?.marketing) load();
  } catch {}
  window.addEventListener("osd:consent", (e) => { if ((e as CustomEvent).detail?.marketing) load(); });
</script>
