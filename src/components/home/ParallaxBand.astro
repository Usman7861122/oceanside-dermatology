---
import AppointmentButton from "../AppointmentButton.astro";
---
<section
  id="south-bay"
  class="parallax-window relative isolate flex min-h-[78vh] items-center bg-ink text-white"
  style="background-image: url('/images/south-bay-pier.webp')"
  aria-label="Serving the South Bay"
>
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_60%_55%_at_50%_50%,rgb(15_34_41/0.55),transparent_75%),linear-gradient(180deg,rgb(15_34_41/0.45),rgb(15_34_41/0.65))]"></div>
  <div class="mx-auto w-full max-w-7xl px-5 text-center sm:px-8">
    <p class="eyebrow justify-center !text-gold-soft" data-reveal><span class="rule-gold"></span>Proudly local<span class="rule-gold"></span></p>
    <p class="mx-auto mt-8 max-w-4xl font-display text-4xl font-light leading-[1.1] [text-wrap:balance] sm:text-6xl lg:text-7xl" data-reveal style="--reveal-delay:120ms">
      Skin care, rooted in <em class="text-gold-soft">the South Bay</em>
    </p>
    <p class="mx-auto mt-6 max-w-xl text-white/80" data-reveal style="--reveal-delay:220ms">
      Caring for families from Torrance, Redondo Beach, Palos Verdes, Manhattan Beach and nearby communities.
    </p>
    <div class="mt-10 flex justify-center" data-reveal style="--reveal-delay:320ms">
      <AppointmentButton glass />
    </div>
  </div>
</section>
