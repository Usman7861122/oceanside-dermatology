---
// Full-screen mission over a photo of Dr. Sandhu and her team, with a fixed-window parallax background
// (fixed on desktop; touch devices and iOS fall back to a normal background).
const pillars = [
  { title: "Prevention", text: "Skin checks, sun safety and early detection that truly save lives." },
  { title: "Education", text: "Clear answers, so you understand your skin and your options." },
  { title: "Long-term skin health", text: "A lasting relationship with a dermatologist who knows you." },
];
---
<section
  id="mission"
  class="parallax-window relative isolate flex min-h-[100svh] flex-col justify-center bg-ink py-28 text-white sm:py-36"
  style="background-image: url('/images/practice/team-chat-wide.webp'); background-position: center 40%;"
>
  <!-- Dark tint: even wash plus a deeper pool behind the centered text -->
  <div class="absolute inset-0 -z-10 bg-[rgb(10_22_27/0.62)]"></div>
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_60%_55%_at_50%_50%,rgb(10_22_27/0.45)_0%,transparent_75%)]"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-1/3 bg-gradient-to-t from-[rgb(10_22_27/0.7)] to-transparent"></div>
  <div class="mx-auto max-w-5xl px-5 text-center sm:px-8">
    <p class="eyebrow justify-center !text-gold-soft" data-reveal><span class="rule-gold"></span>Our Mission<span class="rule-gold"></span></p>
    <blockquote class="mt-10" data-reveal style="--reveal-delay:120ms">
      <p class="font-display text-[2rem] font-light leading-[1.2] text-white sm:text-5xl lg:text-[3.4rem]">
        “To deliver exceptional, personalized dermatologic care with{" "}
        <em class="text-gold-soft">warmth, integrity</em> and clinical excellence, treating every patient as
        we would our own family.”
      </p>
    </blockquote>
    <p class="mx-auto mt-10 max-w-2xl text-white/70" data-reveal style="--reveal-delay:220ms">
      Expert, evidence-based care for the full range of skin, hair and nail conditions, for patients of all
      ages and all skin types, in one convenient, welcoming setting.
    </p>
  </div>

  <div class="mx-auto mt-20 max-w-6xl px-5 sm:px-8">
    <div class="grid gap-4 sm:grid-cols-3">
      {pillars.map((p, i) => (
        <div data-reveal style={`--reveal-delay:${120 * i}ms`}>
          <div class="pillar group relative h-full overflow-hidden rounded-[var(--radius-photo)] border border-white/10 bg-[rgb(10_22_27/0.45)] px-8 py-10 text-center backdrop-blur-md">
            <!-- Gold line draws in from the center on hover -->
            <span class="absolute left-1/2 top-0 h-px w-0 -translate-x-1/2 bg-gold transition-all duration-700 [transition-timing-function:var(--ease-tide)] group-hover:w-full" aria-hidden="true"></span>
            <!-- Soft gold glow rising from the bottom -->
            <span class="pointer-events-none absolute inset-x-0 bottom-0 h-2/3 bg-[radial-gradient(ellipse_70%_60%_at_50%_100%,rgb(236_143_46/0.18),transparent_70%)] opacity-0 transition-opacity duration-700 group-hover:opacity-100" aria-hidden="true"></span>
            <span class="relative mx-auto block h-px w-8 bg-gold/60 transition-all duration-700 [transition-timing-function:var(--ease-tide)] group-hover:w-14 group-hover:bg-gold" aria-hidden="true"></span>
            <h3 class="relative mt-6 text-2xl !text-white transition-colors duration-500 group-hover:!text-gold">{p.title}</h3>
            <p class="relative mt-3 text-[0.95rem] text-white/65 transition-colors duration-500 group-hover:text-white/90">{p.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pillar {
    transition: transform 0.7s var(--ease-tide), background-color 0.7s var(--ease-tide), border-color 0.7s var(--ease-tide), box-shadow 0.7s var(--ease-tide);
  }
  .pillar:hover {
    transform: translateY(-6px);
    background-color: rgb(255 255 255 / 0.08);
    border-color: rgb(236 143 46 / 0.45);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
  }
  @media (prefers-reduced-motion: reduce) {
    .pillar:hover { transform: none; }
  }
</style>
