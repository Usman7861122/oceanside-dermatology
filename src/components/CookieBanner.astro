---
// Compact cookie card. Accept all, Reject, or Customize (Analytics and Marketing toggles).
// The choice is saved in localStorage as "osd-consent" and announced with an "osd:consent" event,
// so scripts such as analytics or the map can wait for it. Any element with
// [data-cookie-settings] reopens the card (the footer has one).
const groups = [
  { key: "necessary", title: "Necessary", text: "Keep the site working and remember this choice.", locked: true },
  { key: "analytics", title: "Analytics", text: "Help us see which pages are useful, without naming you." },
  { key: "marketing", title: "Marketing", text: "Allow content from partners such as Google Maps." },
];
---
<div id="cookie-card" role="dialog" aria-modal="false" aria-labelledby="cookie-title" aria-describedby="cookie-text" hidden
  class="cookie-card fixed inset-x-3 bottom-[4.25rem] z-50 max-h-[calc(100svh-6rem)] overflow-y-auto rounded-[var(--radius-photo)] border border-white/12 bg-ink/95 text-white shadow-[0_30px_70px_-25px_rgb(0_0_0/0.7)] backdrop-blur-md sm:inset-x-auto sm:left-5 sm:w-[23rem] lg:bottom-5">
  <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold to-transparent" aria-hidden="true"></span>
  <div class="p-5">
    <div class="flex items-start gap-3">
      <svg class="mt-0.5 h-5 w-5 shrink-0 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5" /><path d="M8.5 8.5v.01M16 15.5v.01M12 12v.01M11 17v.01M7 14v.01" /></svg>
      <div>
        <p id="cookie-title" class="m-0 font-display text-[1.15rem] leading-tight">Your privacy</p>
        <p id="cookie-text" class="m-0 mt-1.5 text-[0.82rem] leading-relaxed text-white/70">
          We use cookies to run this site and, with your OK, to understand visits. <a href="/cookie-policy" class="text-gold-soft underline decoration-gold/40 underline-offset-2 hover:decoration-gold">Cookie policy</a>
        </p>
      </div>
    </div>

    <div id="cookie-prefs" class="mt-4 hidden space-y-2 border-t border-white/10 pt-4">
      {groups.map((g) => (
        <label class="cookie-row flex cursor-pointer items-start justify-between gap-4 rounded-[3px] px-2 py-2">
          <span>
            <span class="block text-[0.85rem] text-white">{g.title}{g.locked && <span class="ml-2 text-[0.62rem] tracking-[0.18em] uppercase text-gold-soft">Always on</span>}</span>
            <span class="block text-[0.76rem] leading-snug text-white/55">{g.text}</span>
          </span>
          <input type="checkbox" class="cookie-switch mt-0.5 shrink-0" data-group={g.key} checked={g.locked} disabled={g.locked} aria-label={`${g.title} cookies`} />
        </label>
      ))}
    </div>

    <div class="mt-4 grid grid-cols-2 gap-2">
      <button type="button" data-cookie="reject" class="cookie-btn border border-white/25 text-white/85 hover:border-white/60 hover:text-white">Reject</button>
      <button type="button" data-cookie="accept" class="cookie-btn border border-gold bg-gold text-ink hover:bg-gold-soft">Accept all</button>
      <button type="button" data-cookie="customize" class="cookie-btn col-span-2 text-white/70 hover:text-gold-soft">Customize</button>
      <button type="button" data-cookie="save" class="cookie-btn col-span-2 hidden border border-gold/60 text-gold-soft hover:border-gold hover:bg-gold hover:text-ink">Save my choices</button>
    </div>
  </div>
</div>

<style>
  .cookie-card:not([hidden]) { animation: cookie-in 0.6s var(--ease-tide) both; }
  @keyframes cookie-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  .cookie-btn {
    border-radius: 3px;
    padding: 0.7rem 0.75rem;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: color 0.3s, background-color 0.3s, border-color 0.3s;
  }
  .cookie-btn:focus-visible, .cookie-switch:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 2px; }
  .cookie-row { transition: background-color 0.3s; }
  .cookie-row:hover { background-color: rgb(255 255 255 / 0.05); }
  /* Rectangular switch to match the site's square buttons */
  .cookie-switch {
    appearance: none;
    position: relative;
    width: 2.4rem;
    height: 1.3rem;
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: 3px;
    background: transparent;
    cursor: pointer;
    transition: background-color 0.3s, border-color 0.3s;
  }
  .cookie-switch::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: calc(1.3rem - 6px);
    height: calc(1.3rem - 6px);
    border-radius: 2px;
    background: rgb(255 255 255 / 0.7);
    transition: transform 0.3s var(--ease-tide), background-color 0.3s;
  }
  .cookie-switch:checked { background: var(--color-gold); border-color: var(--color-gold); }
  .cookie-switch:checked::after { transform: translateX(1.1rem); background: var(--color-ink); }
  .cookie-switch:disabled { opacity: 0.55; cursor: not-allowed; }
  @media (prefers-reduced-motion: reduce) {
    .cookie-card:not([hidden]) { animation: none; }
    .cookie-switch::after { transition: none; }
  }
</style>

<script>
  const KEY = "osd-consent";
  const card = document.getElementById("cookie-card") as HTMLElement | null;
  const prefs = document.getElementById("cookie-prefs");
  const btn = (n: string) => card?.querySelector<HTMLButtonElement>(`[data-cookie="${n}"]`);
  const box = (g: string) => card?.querySelector<HTMLInputElement>(`[data-group="${g}"]`);

  type Consent = { v: 1; necessary: true; analytics: boolean; marketing: boolean; date: string };
  const read = (): Consent | null => {
    try { return JSON.parse(localStorage.getItem(KEY) ?? "null"); } catch { return null; }
  };

  const setCustomize = (on: boolean) => {
    prefs?.classList.toggle("hidden", !on);
    btn("customize")?.classList.toggle("hidden", on);
    btn("save")?.classList.toggle("hidden", !on);
  };

  const open = (customize = false) => {
    if (!card) return;
    const c = read();
    const a = box("analytics"), m = box("marketing");
    if (a) a.checked = !!c?.analytics;
    if (m) m.checked = !!c?.marketing;
    setCustomize(customize);
    card.hidden = false;
  };

  const save = (analytics: boolean, marketing: boolean) => {
    const c: Consent = { v: 1, necessary: true, analytics, marketing, date: new Date().toISOString() };
    try { localStorage.setItem(KEY, JSON.stringify(c)); } catch {}
    window.dispatchEvent(new CustomEvent("osd:consent", { detail: c }));
    if (card) card.hidden = true;
  };

  btn("accept")?.addEventListener("click", () => save(true, true));
  btn("reject")?.addEventListener("click", () => save(false, false));
  btn("customize")?.addEventListener("click", () => { setCustomize(true); box("analytics")?.focus(); });
  btn("save")?.addEventListener("click", () => save(!!box("analytics")?.checked, !!box("marketing")?.checked));

  document.addEventListener("click", (e) => {
    const t = (e.target as HTMLElement | null)?.closest("[data-cookie-settings]");
    if (t) { e.preventDefault(); open(true); }
  });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && card && !card.hidden && read()) card.hidden = true; });

  if (!read()) setTimeout(() => open(false), 900);
</script>
