---
// Phones only: a fixed two-part action bar.
import { site } from "../data/site";
---
<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-white/10 bg-ink text-white lg:hidden">
  <a href={site.phoneHref} class="flex items-center justify-center gap-2 py-4 text-[0.72rem] font-medium tracking-[0.2em] uppercase">
    Call
  </a>
  <a href={site.appointmentHref} class="flex items-center justify-center gap-2 border-l border-white/10 bg-gold/90 py-4 text-[0.72rem] font-semibold tracking-[0.2em] uppercase text-ink">
    Appointment
  </a>
</div>
